# Copy this file to `.env` (or otherwise set these as real environment
# variables) and fill in real values. NEVER commit the actual .env file.

# --- JWT signing secret (used by auth_utils.py -- pre-existing) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECUREFORENSICS_JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# --- Face-embedding encryption key (NEW -- required for face auth) ---
# Must decode from base64 to exactly 32 bytes (AES-256-GCM key).
# Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SECUREFORENSICS_FACE_ENC_KEY=CHANGE_THIS_TO_A_GENERATED_32_BYTE_BASE64_KEY

# --- Face match threshold (NEW -- optional, has a documented default) ---
# Cosine similarity cutoff for SFace embedding matching. See README.md
# "Threshold Tuning" before relying on the default in any real deployment.
SECUREFORENSICS_FACE_THRESHOLD=0.363
